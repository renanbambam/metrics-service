{
  "title": "Transactions",
  "uid": "transactions-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(transactions_total[1m]))",
          "legendFormat": "sucesso",
          "refId": "A"
        },
        {
          "expr": "sum(rate(transactions_failed_total[1m]))",
          "legendFormat": "falha",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência por percentil",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(transactions_processing_time_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(transactions_processing_time_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(transactions_processing_time_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de erro",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(transactions_failed_total[5m])) / (sum(rate(transactions_total[5m])) + sum(rate(transactions_failed_total[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Valor médio por transação",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyBRL" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(transactions_amount_sum[5m]) / rate(transactions_amount_count[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total de transações processadas",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(transactions_total)",
          "refId": "A"
        }
      ]
    }
  ]
}
